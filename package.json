{
  "name": "campusai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev:web": "npm run dev -w @campusai/web",
    "dev:api": "npm run dev -w @campusai/api",
    "build": "npm run build --workspaces",
    "lint": "eslint apps",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "db:generate": "npm run db:generate -w @campusai/api",
    "db:validate": "npm run db:validate -w @campusai/api",
    "test:integration": "npm run test:integration -w @campusai/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
